{
  "version": 2,

  "redirects": [
    {
      "source": "/scroll/a-history-of-lost-worlds",
      "destination": "/scroll/history-of-lost-worlds",
      "permanent": true
    },
    {
      "source": "/scroll/eternum-agent-first-design",
      "destination": "/scroll",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_VERSION": "22.x"
  }
}
